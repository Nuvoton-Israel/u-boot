/dts-v1/;

#include <dt-bindings/phy/nuvoton,npcm-usbphy.h>
#include "nuvoton-npcm945.dtsi"
#include "nuvoton-npcm945-pincfg.dtsi"

/ {
	model = "Nuvoton npcm945 Development Board (Device Tree)";
	compatible = "nuvoton,npcm945-evb", "nuvoton,npcm945";

	aliases {
		serial0 = &serial0;
		serial4 = &serial4;
		ethernet1 = &gmac1;
		ethernet2 = &gmac2;
		ethernet3 = &xgmac;
#if 0 //az
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
		i2c10 = &i2c10;
		i2c11 = &i2c11;
		i2c12 = &i2c12;
		i2c13 = &i2c13;
		i2c14 = &i2c14;
		i2c15 = &i2c15;
		i2c16 = &i2c16;
		i2c17 = &i2c17;
		i2c18 = &i2c18;
		i2c19 = &i2c19;
		i2c20 = &i2c20;
		i2c21 = &i2c21;
		i2c22 = &i2c22;
		i2c23 = &i2c23;
		i2c24 = &i2c24;
		i2c25 = &i2c25;
		i2c26 = &i2c26;
#endif
		spi0 = &fiu0;
#if 0
		spi1 = &fiu1;
		spi3 = &fiu3;
		spi4 = &fiux;
		spi5 = &pspi;
#endif
		usb0 = &xhci0;
		usb1 = &xhci1;
#if 0
		usb1 = &ehci1;
		usb2 = &udc8;
#endif
	};

	chosen {
		stdout-path = &serial4;
	};

	memory {
		reg = <0x0 0x0 0x0 0x40000000>;
	};

#if 0  //az
	tpm@0 {
		compatible = "microsoft,ftpm";
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	vsbr2: vsbr2 {
		compatible = "regulator-npcm845";
		regulator-name = "vr2";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vsbv8: vsbv8 {
		compatible = "regulator-npcm845";
		regulator-name = "v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vsbv5: vsbv5 {
		compatible = "regulator-npcm845";
		regulator-name = "v5";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
#endif
};

&serial0 {
	status = "okay";
};

&serial4 {
	status = "okay";
};


&watchdog1 {
	status = "okay";
};

&fiu0 {
	status = "okay";
	pinctrl-names = "default";
#if 0
	pinctrl-0 = <&spi0cs1_pins>;
#endif
	spi-nor@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
	spi_flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <25000000>;
	};
};

#if 0  //az

&fiu1 {
	status = "okay";
	spi-nor@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
};

&fiu3 {
	pinctrl-0 = <&spi3_pins>, <&spi3quad_pins>;
	status = "okay";
	vqspi-supply = <&vsbv5>;
	vqspi-microvolt = <3300000>;
	spi-nor@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
};

&fiux {
	nuvoton,spix-mode;
	status = "okay";
};

#endif

&gmac1 {
	phy-mode = "rmii";
	status = "okay";
#if 0
	max-speed = <100>;
	use-ncsi;
	pinctrl-0 = <&r1_pins
		     &r1en_pins
		     &r1oen_pins>;
#endif
	fixed-link {
				speed = <100>;
				//speed = <1000>;
				full-duplex;
		};
};


&gmac2 {
	//phy-mode = "rmii";
	//phy-mode = "xgmii";
	phy-mode = "rgmii-id";
#if 0 // bitbang most likely not needed
	pinctrl-names = "default";
	pinctrl-0 = <&r2_pins
		     &r2oen_pins
		     &r2en_pins
		     &gpio91o_pins
		     &gpio92o_pins>;
	snps,bitbang-mii;
	snps,mdc-gpio = <&gpio2 27 GPIO_ACTIVE_HIGH>;     /* gpio91 */
	snps,mdio-gpio = <&gpio2 28 GPIO_ACTIVE_HIGH>;    /* gpio92 */
	snps,reset-active-low;
	snps,reset-delays-us = <0 10000 500000>;
	snps,reset-gpio = <&gpio2 29 GPIO_ACTIVE_LOW>;    /* gpio93 */
#endif
	status = "okay";
	fixed-link {
				//speed = <100>;
				speed = <1000>;
				full-duplex;
		};
};

&xgmac {
	/*
	 * Select one of the NPCM XPCS modes below. The reference clock must
	 * match the board wiring; USXGMII uses the external 156.25 MHz source.
	 *
	 * phy-mode = "sgmii";
	 * nuvoton,ref-clock-frequency = <125000000>;
	 * // Add nuvoton,ref-clock-from-pad for an external 125 MHz source.
	 * fixed-link {
	 *     speed = <1000>;
	 *     full-duplex;
	 * };
	 *
	 * phy-mode = "usxgmii";
	 * nuvoton,ref-clock-frequency = <156250000>;
	 * nuvoton,ref-clock-from-pad;
	 * // Add nuvoton,phy-side for PHY-side USXGMII configuration.
	 * fixed-link {
	 *     speed = <10000>;
	 *     full-duplex;
	 * };
	 */
	//phy-mode = "rmii";
	phy-mode = "sgmii";
	//phy-mode = "rgmii-id";
#if 0 // bitbang most likely not needed
	pinctrl-names = "default";
	pinctrl-0 = <&r2_pins
		     &r2oen_pins
		     &r2en_pins
		     &gpio91o_pins
		     &gpio92o_pins>;
	snps,bitbang-mii;
	snps,mdc-gpio = <&gpio2 27 GPIO_ACTIVE_HIGH>;     /* gpio91 */
	snps,mdio-gpio = <&gpio2 28 GPIO_ACTIVE_HIGH>;    /* gpio92 */
	snps,reset-active-low;
	snps,reset-delays-us = <0 10000 500000>;
	snps,reset-gpio = <&gpio2 29 GPIO_ACTIVE_LOW>;    /* gpio93 */
#endif
	status = "okay";
	nuvoton,ref-clock-frequency = <125000000>;
	fixed-link {
				speed = <1000>;
				full-duplex;
		};
};
#if 0 //az

&pspi {
	status = "okay";
};

&usbphy1 {
	status = "okay";
};

&usbphy2 {
	status = "okay";
};

&usbphy3 {
	status = "okay";
};
#endif

&xhci0 {
	status = "okay";
#if 0
	phys = <&usbphy1 NPCM_UDC0_7>;
#endif
};

&xhci1 {
	status = "okay";
	dr_mode = "peripheral";

#if 0
	phys = <&usbphy1 NPCM_UDC0_7>;
#endif
};


&sdhci0 {
	bus-width = <8>;
	non-removable;
	status = "okay";
};

#if 0//az
&ehci1 {
	status = "okay";
	phys = <&usbphy2 NPCM_USBH1>;
};

&udc8 {
	status = "okay";
	phys = <&usbphy3 NPCM_UDC8>;
};

&rng {
	status = "okay";
};

&aes {
	status = "okay";
};

&sha {
	status = "okay";
};

&otp {
	status = "okay";
};

